{
  "name": "santio-research-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "build:vercel": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts --mode vercel",
    "check": "tsc -p frontend/tsconfig.json",
    "test": "node --experimental-strip-types --test frontend/tests/*.test.ts"
  },
  "dependencies": {"react": "19.3.0", "react-dom": "19.3.0"},
  "devDependencies": {"vite": "8.3.4", "@vitejs/plugin-react": "6.1.2", "typescript": "7.0.2", "@types/react": "^19", "@types/react-dom": "^19", "@types/node": "^22"}
}

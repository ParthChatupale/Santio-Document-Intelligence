# Database settings for the vector RAG sandbox, not a separate Python environment.
# Copy to .env and set the application login password. Never commit .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=santio_vector_sandbox
PGUSER=santio_vector_app
PGPASSWORD=replace_with_your_database_password
PGCONNECT_TIMEOUT=5

# rag.py reads answer credentials from C:\Santio\.env by default.
# No second API key is needed. To use this file for the answer connection too,
# set the fields below and pass --llm-env-file .\playground\vector-rag\.env.
# NVIDIA_API_KEY=your_key
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
